# 改行コードの固定（Git for Windows の autocrlf でクローンしても WSL の bash が動くように）
*.sh    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.compact text eol=lf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
# バイナリ
*.prover   binary
*.verifier binary
*.bzkir    binary
*.png      binary
*.pptx     binary
*.html     -diff
